# ============================================================
# newapi-logger 环境变量配置
# 复制为 .env 文件，按实际情况修改
#
# 端口说明（示例，按你的实际环境改）：
#   newapi 对外            : 55000
#   vllm 大模型            : 55001 / 55002 / 55003
#   bge 词向量             : 55006
#   rerank 重排序          : 55006
#   通义-Z-imate-turbo     : 54001
# ============================================================

# === newapi 后端地址（必填）===
NEWAPI_URL=http://newapi:55000
NEWAPI_HOST=newapi
NEWAPI_PORT=55000

# === 本服务监听（避开所有占用端口）===
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8100

# === MySQL 连接（必填）===
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=newapi_logs

# === MySQL 连接池（高并发优化）===
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=8
DB_WORKER_THREADS=3
DB_QUEUE_MAXSIZE=10000

# === 日志 ===
LOG_LEVEL=INFO
FULL_LOG_MAX_MB=100
FULL_LOG_BACKUPS=30
ERROR_LOG_MAX_MB=50
ERROR_LOG_BACKUPS=10

# === HTTP 连接池（高并发优化）===
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_KEEPALIVE=100
HTTP_TIMEOUT=300
HTTP_CONNECT_TIMEOUT=10
PROXY_READ_TIMEOUT=600

# === 流式内存控制 ===
MAX_STREAM_BUFFER_SIZE=10485760

# === 令牌脱敏 ===
# true=存库时只保留前后8位; false=完整保存（推荐false，用于精确追踪用户）
TOKEN_MASK=false

# === 日志文件宿主机路径 ===
LOG_HOST_DIR=./api-logger/logs

# === Docker 网络名称 ===
# 确保与 newapi / MySQL 在同一网络
DOCKER_NETWORK=newapi-net
